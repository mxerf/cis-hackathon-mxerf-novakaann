# Timeweb AI Gateway (OpenAI-compatible endpoint)
AI_GATEWAY_URL=https://agent.timeweb.cloud/api/v1/cloud-ai/agents/your-agent-id/v1
AI_GATEWAY_TOKEN=
AI_MODEL=anthropic/claude-haiku-5-5

# Optional Telegram trusted-contact alert
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Backend server port (Vite proxies /api and /ws here)
PORT=3001
